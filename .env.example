# ===========================================
# Claude Code WSL Bridge - 环境变量配置
# ===========================================
# 复制此文件为 .env 并填入你的配置

# API 供应商 (deepseek / openai / kimi / zhipu / openrouter)
MODEL_PROVIDER=deepseek

# API Key（从供应商后台获取）
API_KEY=your_api_key_here

# 模型名称（根据供应商调整）
MODEL_NAME=deepseek-chat

# API 端点（一般不需要改）
API_BASE_URL=https://api.deepseek.com
