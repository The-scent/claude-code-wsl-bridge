# ===========================================
# Claude Code WSL Bridge - 环境变量模板
# ===========================================
# 复制此文件为 .env 并填入你的配置:
#   cp .env.example .env
#
# 注意: 从 2026-07 版本开始，推荐通过 nervhub init
# 交互式配置，而不是手工编辑此文件。
# 此文件保留作为传统方式的参考。
# ===========================================

# API 供应商 (deepseek / openai / kimi / zhipu / openrouter)
MODEL_PROVIDER=deepseek

# API Key（从供应商后台获取）
API_KEY=your_api_key_here

# 模型名称（根据供应商调整）
# DeepSeek: deepseek-chat, deepseek-reasoner
# 智谱:    glm-4-plus
# OpenAI:  gpt-4o
# Kimi:    moonshot-v1-8k
MODEL_NAME=deepseek-chat

# API 端点（保持默认即可）
# DeepSeek: https://api.deepseek.com
# 智谱:     https://open.bigmodel.cn/api/paas/v4
# OpenAI:   https://api.openai.com/v1
API_BASE_URL=https://api.deepseek.com

# ===========================================
# 以下为桥接层相关配置（不直接由 Claude Code 使用）
# ===========================================

# 本地代理端口（NervHub / openclaudecode 默认监听端口）
BRIDGE_PORT=11500

# Claude Code 的 API 基础地址（指向本地代理）
# 也可通过 ~/.bashrc 设置:
#   export ANTHROPIC_BASE_URL=http://127.0.0.1:11500
ANTHROPIC_BASE_URL=http://127.0.0.1:11500
